{
  "version": "0.2.0",
  "status": "control_retest",
  "owner": "GBO",
  "purpose": "CODEX-side bridge for style/readability/render QA controls consumed by ABACUS and controlled evidence lanes.",
  "authority": {
    "mode": "bridge_contract",
    "primary_consumer": "GBOGEB/ABACUS",
    "source_repo": "GBOGEB/CODEX",
    "controlled_evidence_lane": "generic_private_adapter",
    "binary_policy": "generated_artifacts_are_validated_locally_or_in_ci_and_are_not_required_in_git"
  },
  "palette_bridge": {
    "source": "themes/semantic_cards.yaml",
    "required_cards": [
      "warning",
      "decision",
      "ssot"
    ],
    "required_modes": [
      "light",
      "dark"
    ],
    "required_tokens": [
      "background",
      "text",
      "border"
    ],
    "minimum_contrast_ratio": 7
  },
  "artifact_lanes": {
    "html": {
      "role": "primary_render_surface",
      "controls": [
        "semantic_html",
        "dashboard_health",
        "link_validation",
        "console_error_watch",
        "overflow_watch"
      ]
    },
    "pdf": {
      "role": "release_render_surface",
      "controls": [
        "page_render",
        "blank_page_detection",
        "footer_traceability",
        "checksum_manifest"
      ]
    },
    "pptx": {
      "role": "presentation_render_surface",
      "controls": [
        "theme_tokens",
        "slide_render",
        "overlap_detection",
        "source_notes"
      ]
    },
    "excel": {
      "role": "numeric_ssot_consumer",
      "controls": [
        "schema_trace",
        "formula_error_detection",
        "scenario_roundtrip",
        "checksum_manifest"
      ]
    },
    "graphs": {
      "role": "topology_and_runtime_surface",
      "controls": [
        "node_manifest",
        "edge_manifest",
        "runtime_status",
        "federation_export"
      ]
    }
  },
  "awake_probes": [
    {
      "id": "semantic_cards",
      "kind": "style",
      "path": "themes/semantic_cards.yaml",
      "weight": 4
    },
    {
      "id": "wcag_contrast_workflow",
      "kind": "ci",
      "path": ".github/workflows/wcag-contrast.yml",
      "weight": 3
    },
    {
      "id": "render_governance_workflow",
      "kind": "ci",
      "path": ".github/workflows/render-governance-ci.yml",
      "weight": 4
    },
    {
      "id": "render_regression_workflow",
      "kind": "ci",
      "path": ".github/workflows/render-regression.yml",
      "weight": 4
    },
    {
      "id": "runtime_federation_workflow",
      "kind": "federation",
      "path": ".github/workflows/runtime_federation_ci.yml",
      "weight": 4
    },
    {
      "id": "dashboard_health_workflow",
      "kind": "html",
      "path": ".github/workflows/dashboard-health.yml",
      "weight": 3
    },
    {
      "id": "render_guard",
      "kind": "render",
      "path": "scripts/render_guard.py",
      "weight": 3
    },
    {
      "id": "theme_runtime_tests",
      "kind": "test",
      "path": "tests/test_theme_runtime.py",
      "weight": 3
    },
    {
      "id": "contrast_tests",
      "kind": "test",
      "path": "tests/test_g7_contrast_validator.py",
      "weight": 3
    },
    {
      "id": "keb_client_tests",
      "kind": "keb",
      "path": "tests/test_keb_client.py",
      "weight": 2
    },
    {
      "id": "federation_scree_tests",
      "kind": "pca",
      "path": "tests/test_federation_scree.py",
      "weight": 2
    }
  ],
  "pca_axes": [
    {
      "id": "P5",
      "name": "keb_feedback_depth",
      "load_direction": "catchup",
      "focus": "explicit KEB runtime evidence, queue status and feedback-loop closure"
    },
    {
      "id": "P4",
      "name": "render_regression_depth",
      "load_direction": "catchup",
      "focus": "replace placeholders with screenshot/html semantic diffs and Playwright output"
    },
    {
      "id": "P3",
      "name": "artifact_lane_binding",
      "load_direction": "catchup",
      "focus": "bind HTML/PDF/PPTX/Excel/graph lanes to one manifest and checksum family"
    },
    {
      "id": "P2",
      "name": "style_authority",
      "load_direction": "stabilize",
      "focus": "semantic card palette and high-contrast token policy"
    },
    {
      "id": "P1",
      "name": "ci_governance",
      "load_direction": "stabilize",
      "focus": "workflow grouping, slim/full tiers and release gates"
    }
  ],
  "bt_priority": {
    "method": "rank_by_low_score_then_high_weight_then_release_impact",
    "current_top_focus": [
      "keb_feedback_depth",
      "render_regression_depth",
      "artifact_lane_binding"
    ]
  },
  "dmaic": {
    "define": "CODEX is the reusable style/render/CI governance bridge, not the numeric or private evidence SSOT.",
    "measure": "Score palette, artifact lane, awake probe and penetration depth independently.",
    "analyze": "Use reversed PCA loading order P5 to P1 to lift underdeveloped KEB/render lanes first.",
    "improve": "Add one code-only validator before binding it into larger CI tiers.",
    "control": "Keep the bridge manifest small, testable and binary-free."
  },
  "federation_consumers": {
    "wave_id": "SSOT-STYLE-W04",
    "public_consumer": "GBOGEB/ABACUS",
    "controlled_adapter": "GBOGEB/cryoplant-project",
    "shared_lanes": [
      "html",
      "pdf",
      "pptx",
      "excel",
      "graphs",
      "ci",
      "dow",
      "keb"
    ],
    "method_order": [
      "DMAIC",
      "PCA_REVERSED_P5_TO_P1",
      "BT_PRIORITY"
    ],
    "bridge_rules": [
      "CODEX defines reusable validation meaning, not final artifact release status.",
      "ABACUS owns user-facing artifact readiness summaries and scenario-I/O state.",
      "cryoplant-project may emit status, hashes, counts and evidence references only.",
      "Heavy PPTX/PDF/XLSX/HTML rendering evidence belongs in full or scheduled tiers unless the PR touches the local validator itself."
    ]
  },
  "handoff_check_policy": {
    "wave_id": "SSOT-STYLE-W04",
    "linked_repair_prs": {
      "GBOGEB/ABACUS": [
        754,
        756
      ],
      "GBOGEB/CODEX": [
        298,
        300
      ]
    },
    "blocking_conclusions": [
      "failure",
      "timed_out",
      "action_required",
      "startup_failure",
      "stale"
    ],
    "manual_review_conclusions": [
      "cancelled"
    ],
    "pending_statuses": [
      "queued",
      "in_progress",
      "requested",
      "waiting",
      "pending"
    ],
    "all_clear_rule": "A DMAIC/PCA/BT handoff all-clear may be recorded only when CODEX and ABACUS head and merge checks have no blocking conclusions, no unwaived cancelled checks, and no pending required checks.",
    "repository_feedback": {
      "from_abacus": "ABACUS provides user-facing artifact readiness, runtime receipt and scenario-I/O status back to CODEX bridge governance.",
      "to_abacus": "CODEX provides reusable validation meaning, check-disposition taxonomy and release-manifest expectations to ABACUS."
    },
    "all_clear_requirements": [
      "no_blocking_conclusions",
      "no_unwaived_cancelled_checks",
      "no_pending_required_checks",
      "no_unresolved_material_reviews",
      "repaired_sha_retested",
      "downstream_return_receipt_accepted"
    ]
  },
  "lineage_binding": {
