{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "w190-keb-3pc-mip-receipt/1.0",
  "type": "object",
  "required": ["schema_version", "wave", "repo", "consumed_child", "consumed_dow", "keb_disposition"],
  "properties": {
    "schema_version": {"const": "w190-keb-3pc-mip-receipt/1.0"},
    "wave": {"const": "W190"},
    "repo": {"const": "GBOGEB/CODEX"},
    "consumed_child": {
      "type": "object",
      "required": ["pr", "head_sha"],
      "properties": {
        "pr": {"type": "string", "format": "uri"},
        "head_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "consumed_dow": {
      "type": "object",
      "required": ["pr", "head_sha"],
      "properties": {
        "pr": {"type": "string", "format": "uri"},
        "head_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "keb_disposition": {"enum": ["ACCEPT_HANDOVER_CHAIN_DEFER_GLOBAL_DOV", "REJECT", "DEFER"]}
  }
}
