{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "missioncontrol/execution-request/0.1",
  "title": "MissionControl authenticated execution request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "created_at",
    "target",
    "action_class",
    "intent",
    "payload_sha256",
    "idempotency_key",
    "authority_transfer",
    "formal_credit_delta",
    "engineering_credit_delta",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "request_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "requested_by_hint": {
      "type": "string",
      "description": "Untrusted UI hint; authenticated principal is bound by the gateway."
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "ref",
        "expected_head_sha"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^GBOGEB/[A-Za-z0-9_.-]+$"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "expected_head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "action_class": {
      "enum": [
        "STAGE_ONLY",
        "APPLY_BOUNDED_CODEX",
        "REQUEST_TYPED_REMOTE_RETURN"
      ]
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority_transfer": {
      "const": false
    },
    "formal_credit_delta": {
      "const": 0
    },
    "engineering_credit_delta": {
      "const": 0
    },
    "approval_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Explicit approval evidence reference. Required by bounded-apply policy; never a secret."
    },
    "dry_run_receipt_ref": {
      "type": "string",
      "pattern": "^mission_control/mycelium/gateway/receipts/[A-Za-z0-9_.-]+\\\\.json$",
      "description": "Repository-relative exact-head STAGE_ONLY predecessor receipt."
    }
  }
}
