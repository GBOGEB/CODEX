{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gbogeb.github.io/CODEX/schemas/qps_w11_offer_evidence.schema.json",
  "title": "QPS W11 OFFER Evidence Register",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source_atoms", "relations", "controls"],
  "properties": {
    "version": {"type": "string", "pattern": "^0\\.1$"},
    "source_atoms": {"type": "array", "items": {"$ref": "#/$defs/sourceAtom"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no_cross_bidder_substitution",
        "no_inference_compliance_credit",
        "no_pca_bt_compliance_credit",
        "child_owned_final_disposition"
      ],
      "properties": {
        "no_cross_bidder_substitution": {"const": true},
        "no_inference_compliance_credit": {"const": true},
        "no_pca_bt_compliance_credit": {"const": true},
        "child_owned_final_disposition": {"const": true}
      }
    }
  },
  "$defs": {
    "sourceAtom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atom_id", "source_id", "source_sha256", "source_format",
        "source_locator", "bidder", "evidence_class", "extracted_text",
        "extraction_method", "extraction_confidence", "bidder_position"
      ],
      "properties": {
        "atom_id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_format": {"enum": ["pdf", "xlsx", "docx", "pptx"]},
        "source_locator": {"type": "string", "minLength": 1},
        "bidder": {"enum": ["ALAT", "LKT", "NONE"]},
        "evidence_class": {
          "enum": [
            "CONTROLLED", "SOURCE_SUPPORTED", "DERIVED", "POSTULATED",
            "INFERRED"
          ]
        },
        "extracted_text": {"type": "string", "minLength": 1},
        "extraction_method": {"type": "string", "minLength": 1},
        "extraction_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "bidder_position": {
          "enum": [
            "ACCEPT_UNCONDITIONAL", "COMPLIANT_WITH_REFERENCE",
            "QUALIFICATION", "CLARIFICATION", "SUGGESTION", "DEVIATION",
            "EXCLUSION", "MISSING_EVIDENCE", "NOT_APPLICABLE",
            "CONFLICTING_EVIDENCE"
          ]
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_id", "atom_id", "target_type", "target_id",
        "relation_type", "lexical_score", "reviewer_state"
      ],
      "properties": {
        "relation_id": {"type": "string", "minLength": 1},
        "atom_id": {"type": "string", "minLength": 1},
        "target_type": {"enum": ["RTM", "OFFER"]},
        "target_id": {"type": "string", "pattern": "^(RTM|OFFER)-[0-9]+$"},
        "relation_type": {
          "enum": [
            "DIRECT_RTM", "DIRECT_OFFER", "SUPPORTING_RTM",
            "SUPPORTING_OFFER", "PRESTUDY_SUPPORT", "CONTRACT_SUPPORT",
            "CONTRADICTS", "QUALIFIES", "DUPLICATES"
          ]
        },
        "lexical_score": {"type": "number", "minimum": 0, "maximum": 1},
        "reviewer_state": {"enum": ["UNREVIEWED", "ACCEPT", "REJECT", "DEFER"]}
      },
      "if": {"properties": {"target_type": {"const": "RTM"}}},
      "then": {"properties": {"target_id": {"pattern": "^RTM-[0-9]+$"}}},
      "else": {"properties": {"target_id": {"pattern": "^OFFER-[0-9]+$"}}}
    }
  }
}
